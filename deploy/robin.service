[Unit]
Description=Robin
After=network-online.target exe-setup.service
Wants=network-online.target

[Service]
Type=simple
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/robin/ms-playwright
ExecStart=/usr/local/bin/robin boot --host 127.0.0.1 --port 8000
Restart=on-failure
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
